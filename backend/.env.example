# Justify backend — local development configuration
# From backend/: cp .env.example .env
# Keep real credentials in .env (gitignored), never in this example.
# These localhost URLs assume Python runs on the host and infrastructure runs
# via docker compose up -d. Docker Compose credentials below are LOCAL ONLY.
# DATABASE_URL is enough for migrations; chat needs a real provider API key.

# PostgreSQL — matches docker-compose.yml; asyncpg is required by the backend.
DATABASE_URL=postgresql+asyncpg://justify_user:justify_password@localhost:5432/justify

# Redis — cache and conversation memory.
REDIS_URL=redis://localhost:6379/0

# Qdrant: the API defaults to the local index produced by
#   uv run python scripts/reindex_hybrid.py --demo --output qdrant_db_demo
# Then change QDRANT_PATH below to qdrant_db_demo.
# Set an absolute QDRANT_PATH if launching from outside backend/.
# For server mode (e.g. Docker Qdrant on localhost:6333), set QDRANT_URL.
# Note: QDRANT_URL and a custom QDRANT_PATH cannot both be set.
QDRANT_PATH=qdrant_db
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your-qdrant-api-key-here

# Allowed CORS origins (comma-separated or JSON list). Default: *
CORS_ORIGINS=*

# LLM provider — deepseek (default), openai, groq, or gemini.
# When switching providers, also choose a model supported by that provider.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=30
LLM_MAX_TOKENS=600

# DeepSeek — required for chat when LLM_PROVIDER=deepseek.
DEEPSEEK_API_KEY=
# Explicit provider endpoint; the factory also defaults to this DeepSeek endpoint.
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI — optional alternative provider (OPEN_AI_API_KEY is a legacy alias).
OPENAI_API_KEY=

# Groq — optional alternative provider; set LLM_PROVIDER=groq and LLM_MODEL
# to a model available in your Groq account before using it.
GROQ_API_KEY=

# Gemini — optional native Gemini Developer API provider (not Vertex AI).
# To enable, set LLM_PROVIDER=gemini, LLM_MODEL=gemini-3.5-flash-lite, and
# LLM_MAX_TOKENS=4096 (the default 600-token cap may truncate thinking models).
# Explicit model selection is required; the DeepSeek default is not reused.
# Leave GOOGLE_GENAI_USE_VERTEXAI and GOOGLE_GENAI_USE_ENTERPRISE unset or false.
# Only GEMINI_API_KEY is used for this provider, even if GOOGLE_API_KEY is set.
GEMINI_API_KEY=

# LangSmith / LangChain tracing — optional, disabled by default.
# These values are declared in Settings, but the app does not pass them to
# the tracing SDK. To enable SDK tracing, export them into the process first.
# For this trusted, shell-compatible .env template, you can load all values:
#   set -a; source .env; set +a
# Then run the backend command from the same shell. This also loads QDRANT_URL.
# Use only trusted .env files with source; it executes shell syntax.
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=osj-demo

# Hybrid retrieval — current application defaults.
HYBRID_K_DENSE=20
HYBRID_K_FINAL=5
HYBRID_ALPHA=0.7

# Waitlist welcome emails — optional. Blank API key skips email delivery.
# Sending real mail requires a Resend API key and a verified sender/domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com
